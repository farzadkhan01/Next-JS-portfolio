# Copy to .env.production.local (or set in your hosting provider's settings).
# Never commit real .env files — they are git-ignored.

# Production domain, including https:// and without a trailing slash.
# Used for canonical URLs, Open Graph/Twitter URLs and images, the sitemap,
# robots.txt, and structured data. Leave unset until the domain is confirmed:
# production builds then omit absolute URLs instead of publishing a wrong one.
SITE_URL=
